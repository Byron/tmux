+            sequence,
+            state: serde_json::json!({
+                "sessions": [{"id":1,"name":"test","active":0,"windows":{"0":2}}],
+                "windows": [{"id":2,"name":"shell","active":7,"cols":80,"rows":24,"panes":[7],"layout":Layout::pane(7,80,24).to_legacy().unwrap()}],
