+    #[test]
+    fn timed_out_native_mutation_completes_once_and_keeps_reply_routing_separate() {
+        let endpoint = test_endpoint();
+        let _owner = tmuxx_runtime::start(tmuxx_runtime::Options::new(&endpoint)).unwrap();
+        let client = Connection::local(&endpoint, Arc::new(|| {})).unwrap();
+        let admin = Connection::local(&endpoint, Arc::new(|| {})).unwrap();
+        let args = |values: &[&str]| {
+            values
+                .iter()
+                .map(|value| value.as_bytes().to_vec())
+                .collect()
+        };
+        let reply = |connection: &Connection, values: &[&str]| {
+            let response = connection
+                .command_bytes_reply(args(values), Duration::from_secs(5))
+                .unwrap();
+            assert!(response.error.is_none(), "{:?}", response.error);
+            response.output
+        };
+        let error = client
+            .command_bytes_reply(
+                args(&[
+                    "wait-for",
+                    "ack-release",
+                    ";",
+                    "set-option",
+                    "-ga",
+                    "@ack-mutations",
+                    "x",
+                ]),
+                Duration::from_millis(20),
+            )
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+        assert!(error.to_string().contains("outcome is unknown"));
+        assert!(error.to_string().contains("not replayed"));
+        reply(&admin, &["wait-for", "-S", "ack-release"]);
+        // This acknowledgement follows the delayed mutation on the same FIFO.
+        // A replay would append a second x; a dropped mutation leaves no value.
+        assert_eq!(
+            reply(&client, &["show-options", "-gv", "@ack-mutations"]),
+            b"x\n"
+        );
+        assert!(client.errors().is_empty());
+        client.command(["invalid-async-command"]).unwrap();
+        assert_eq!(
+            reply(&client, &["show-options", "-gv", "@ack-mutations"]),
+            b"x\n"
+        );
+        assert_eq!(client.errors(), ["unknown command: invalid-async-command"]);
+        reply(&client, &["set-option", "-ga", "@ack-mutations", "y"]);
+        assert_eq!(
+            reply(&client, &["show-options", "-gv", "@ack-mutations"]),
+            b"xy\n"
+        );
+        assert!(client.errors().is_empty());
+    }
