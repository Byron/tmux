+    fn agent_events(session: &Session) -> Vec<(rustty_vt::agent::Event, bool)> {
+        session
+            .events()
+            .map(|event| match event {
+                SessionEvent::RestoredAgentStatus {
+                    event,
+                    enclosing_command,
+                } => (event, enclosing_command),
+                other => panic!("unexpected replayed effect: {other:?}"),
+            })
+            .collect()
+    }
