+    /// Select an owner through the first protocol record; the exec command stays fixed.
+    pub fn native_ssh_instance(
+        host: &str,
+        instance: &str,
+        wake: Arc<dyn Fn() + Send + Sync>,
+    ) -> io::Result<Self> {
+        Self::native_ssh_command(
+            host,
+            Some(instance),
+            crate::config::DEFAULT_TMUXX_SSH_COMMAND,
+            wake,
+        )
+    }
+    /// Use an explicit trusted remote-shell command. Selection remains in Hello;
+    /// no pane, session, path, or instance value is interpolated into this command.
+    pub fn native_ssh_command(
+        host: &str,
+        instance: Option<&str>,
+        remote_command: &str,
+        wake: Arc<dyn Fn() + Send + Sync>,
+    ) -> io::Result<Self> {
+        if remote_command.trim().is_empty() || remote_command.contains('\0') {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "native SSH command must be nonempty and contain no NUL",
+            ));
+        }
+        Self::connect_source(
+            Source::Ssh {
+                host: host.to_owned(),
+                instance: instance.map(str::to_owned),
+                config: std::env::var_os("RUSTTY_TMUXX_SSH_CONFIG").map(PathBuf::from),
+                remote_command: remote_command.to_owned(),
+            },
+            wake,
+            true,
+            true,
+        )
+    }
+    fn connect_source(
+        source: Source,
+        wake: Arc<dyn Fn() + Send + Sync>,
+        host_effects: bool,
+        subscribe: bool,
+    ) -> io::Result<Self> {
+        let mut connection = match &source {
+            #[cfg(unix)]
+            Source::Unix(endpoint) => {
+                let stream = std::os::unix::net::UnixStream::connect(endpoint)?;
+                let mut connection = Self::stream_inner(
+                    stream.try_clone()?,
+                    stream.try_clone()?,
+                    wake,
+                    host_effects,
+                    subscribe,
+                )?;
+                connection.socket = Some(stream);
+                connection
+            }
+            #[cfg(windows)]
+            Source::Windows(endpoint) => {
+                let stream = tmuxx_runtime::windows::connect(endpoint)?;
+                let mut connection = Self::stream_inner(
+                    stream.try_clone()?,
+                    stream.try_clone()?,
+                    wake,
+                    host_effects,
+                    subscribe,
+                )?;
+                connection.pipe = Some(stream);
+                connection
+            }
+            Source::Ssh {
+                host,
+                instance,
+                config,
+                remote_command,
+            } => {
+                let args = native_ssh_arguments(host, config.as_deref(), remote_command);
+                #[cfg(not(windows))]
+                let mut child = {
+                    let mut command = Command::new("ssh");
+                    command
+                        .args(&args)
+                        .stdin(Stdio::piped())
+                        .stdout(Stdio::piped())
+                        .stderr(Stdio::inherit())
+                        .spawn()?
+                };
+                #[cfg(windows)]
+                let mut child =
+                    { tmuxx_runtime::spawn_owned_stdio(&windows_ssh_executable()?, &args)? };
+                match Self::stream_inner_selected(
+                    child.stdout.take().unwrap(),
+                    child.stdin.take().unwrap(),
+                    wake,
+                    host_effects,
+                    subscribe,
+                    instance.clone(),
+                ) {
+                    Ok(mut connection) => {
+                        connection.child = Some(child);
+                        connection
+                    }
+                    Err(error) => {
+                        let _ = child.kill();
+                        let _ = child.wait();
+                        return Err(error);
+                    }
+                }
+            }
+            Source::SystemSsh { host, config } => {
+                return Self::system_ssh_config(host, config.clone(), wake);
+            }
+            Source::None => return Err(err("stream caller must provide a size client")),
+        };
+        connection.source = source;
+        Ok(connection)
+    }
+    /// Each OS window registers its own session-size context, preserving the
+    /// server's latest/smallest/largest arbitration across remote GUI clients.
+    pub fn view_size(
+        &self,
+        session: u64,
+        cols: u16,
+        rows: u16,
+        cell_width: u16,
+        cell_height: u16,
+    ) -> io::Result<()> {
+        if let Some(system) = &self.system {
+            return system.view_size(session, cols, rows);
+        }
+        let mut views = self.size_views.lock().map_err(err)?;
+        if let std::collections::btree_map::Entry::Vacant(entry) = views.entry(session) {
+            let connection =
+                Self::connect_source(self.source.clone(), self.shared.wake.clone(), false, false)?;
+            connection.command(["attach-session".into(), "-t".into(), format!("${session}")])?;
+            entry.insert((connection, (0, 0, 0, 0)));
+        }
+        let (connection, size) = views.get_mut(&session).unwrap();
+        if *size != (cols, rows, cell_width, cell_height) {
+            connection.command([
+                "refresh-client".into(),
+                "-C".into(),
+                format!("{cols},{rows}"),
+            ])?;
+            connection.command([
+                "tmuxx-cell-size".into(),
+                cell_width.to_string(),
+                cell_height.to_string(),
+            ])?;
+            *size = (cols, rows, cell_width, cell_height);
+        }
+        let errors = connection.errors();
+        if !errors.is_empty() {
+            return Err(err(errors.join("; ")));
+        }
+        Ok(())
+    }
+    /// Attach a negotiated native byte transport. The caller owns its shutdown.
+    pub fn stream(
+        reader: impl Read + Send + 'static,
+        writer: impl Write + Send + 'static,
+        wake: Arc<dyn Fn() + Send + Sync>,
+    ) -> io::Result<Self> {
+        Self::stream_inner(reader, writer, wake, true, true)
+    }
+    fn stream_inner(
+        reader: impl Read + Send + 'static,
+        writer: impl Write + Send + 'static,
+        wake: Arc<dyn Fn() + Send + Sync>,
+        host_effects: bool,
+        subscribe: bool,
+    ) -> io::Result<Self> {
+        Self::stream_inner_selected(reader, writer, wake, host_effects, subscribe, None)
+    }
+    fn stream_inner_selected(
+        reader: impl Read + Send + 'static,
+        mut writer: impl Write + Send + 'static,
+        wake: Arc<dyn Fn() + Send + Sync>,
+        host_effects: bool,
+        subscribe: bool,
+        instance: Option<String>,
+    ) -> io::Result<Self> {
+        let (connection, requests) = Self::base(wake, subscribe);
+        write_record(
+            &mut writer,
+            &Hello {
+                host_effects,
+                instance,
+                ..Default::default()
+            },
+        )?;
+        let shared = connection.shared.clone();
+        thread::Builder::new()
+            .name("rustty-tmuxx-write".into())
+            .spawn(move || {
+                while !shared.closed.load(Ordering::Acquire) {
+                    match requests.recv_timeout(Duration::from_millis(50)) {
+                        Ok(request) => {
+                            if let Err(error) = write_record(&mut writer, &request) {
+                                fail(&shared, error);
+                                return;
+                            }
+                        }
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                        Err(mpsc::RecvTimeoutError::Disconnected) => return,
+                    }
+                }
+            })?;
+        let shared = connection.shared.clone();
+        thread::Builder::new()
+            .name("rustty-tmuxx-read".into())
+            .spawn(move || {
+                let result = (|| -> io::Result<()> {
+                    let mut reader = BufReader::new(reader);
+                    let hello: Hello = serde_json::from_slice(
+                        &record(&mut reader)?.ok_or_else(|| err("missing tmuxx hello"))?,
+                    )
+                    .map_err(err)?;
+                    if hello.version != tmuxx_protocol::native::VERSION {
+                        return Err(err("unsupported tmuxx native version"));
+                    }
+                    let mut snapshots = SnapshotAssembler::default();
+                    while !shared.closed.load(Ordering::Acquire) {
+                        let Some(bytes) = record(&mut reader)? else {
+                            snapshots.finish()?;
+                            return Err(err("tmuxx disconnected"));
+                        };
+                        if let Some(message) =
+                            snapshots.push(serde_json::from_slice(&bytes).map_err(err)?)?
+                        {
+                            apply(&shared, message)?;
+                        }
+                    }
+                    Ok(())
+                })();
+                if let Err(error) = result {
+                    fail(&shared, error);
+                }
+            })?;
+        if subscribe {
+            connection.command(std::iter::empty::<&str>())?;
+        }
+        Ok(connection)
+    }
+    pub fn command<I, S>(&self, argv: I) -> io::Result<u64>
