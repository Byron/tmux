+//! Native tmuxx connections and independent Rustty pane views.
+//!
+//! The server owns PTYs and application replies. Views own selection, scroll,
+//! and rendering. Closing a view never kills its server-side pane.
+use crate::session::{Input, SessionEvent};
+use rustty_vt::{Effect, Terminal};
+use serde::Deserialize;
+use std::collections::BTreeMap;
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::path::{Path, PathBuf};
+#[cfg(not(windows))]
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, Weak, mpsc};
+use std::thread;
+use std::time::Duration;
+pub use tmuxx_layout::{Axis, Kind, Layout};
+use tmuxx_protocol::native::{Hello, Request, ServerMessage, SnapshotAssembler};
+#[cfg(windows)]
+pub use tmuxx_runtime::windows::endpoint as windows_endpoint;
+#[cfg(windows)]
+pub use tmuxx_runtime::{ConptyIdentity, initialize_conpty};
+
+mod system;
+
+const RECORD_LIMIT: usize = 128 * 1024 * 1024;
+
+fn native_ssh_arguments(
+    host: &str,
+    config: Option<&Path>,
+    remote_command: &str,
+) -> Vec<std::ffi::OsString> {
+    let mut args = Vec::new();
+    if let Some(path) = config {
+        args.push("-F".into());
+        args.push(path.as_os_str().to_owned());
+    }
+    args.extend(["-T", "--", host, remote_command].map(Into::into));
+    args
+}
+
+#[cfg(windows)]
+fn windows_ssh_executable() -> io::Result<PathBuf> {
+    let system = std::env::var_os("SystemRoot")
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "SystemRoot is not set"))?;
+    Ok(PathBuf::from(system).join("System32/OpenSSH/ssh.exe"))
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct Graph {
+    pub sessions: Vec<ServerSession>,
+    pub windows: Vec<ServerWindow>,
+    pub panes: Vec<ServerPane>,
+}
+#[derive(Clone, Debug, Deserialize)]
+pub struct ServerSession {
+    pub id: u64,
+    pub name: String,
+    pub active: u64,
+    pub windows: BTreeMap<u32, u64>,
+}
+#[derive(Clone, Debug, Deserialize)]
+pub struct ServerWindow {
+    pub id: u64,
+    pub name: String,
+    pub active: u64,
+    pub cols: u16,
+    pub rows: u16,
+    pub panes: Vec<u64>,
+    pub layout: String,
+    #[serde(default)]
+    pub zoomed: bool,
+    #[serde(default)]
+    pub zoomed_pane: Option<u64>,
+    #[serde(default)]
+    pub visible_layout: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+pub struct ServerPane {
+    pub id: u64,
+    pub window: u64,
+    #[serde(default)]
+    pub x: Option<i32>,
+    #[serde(default)]
+    pub y: Option<i32>,
+    pub cols: u16,
+    pub rows: u16,
+    pub status: Option<i32>,
+    #[serde(default)]
+    pub persistent: bool,
+    #[serde(default)]
+    pub pid: Option<u32>,
+    #[serde(default)]
+    pub modal: bool,
+    #[serde(default)]
+    pub modal_capture_keys: bool,
+    #[serde(default)]
+    pub modal_close_click: bool,
+    #[serde(default)]
+    pub modal_close_cancel: bool,
+    #[serde(default)]
+    pub terminal: serde_json::Value,
+}
+
+#[derive(Default)]
+struct Model {
+    instance: String,
+    sequence: u64,
+    graph: Option<Graph>,
+    panes: BTreeMap<u64, PaneState>,
+    errors: Vec<String>,
+    last_host_event: Option<u64>,
+    replies: BTreeMap<u64, mpsc::SyncSender<tmuxx_protocol::native::Response>>,
+}
+struct PaneState {
+    host_state: Option<(bool, bool, bool)>,
+    owners: Arc<AtomicUsize>,
+    terminal: Terminal,
+    agent_status: tmuxx_terminal::AgentStatus,
+    views: Vec<View>,
+}
+#[derive(Default)]
+struct AgentView {
+    current: tmuxx_terminal::AgentStatus,
+    delivered: tmuxx_terminal::AgentStatus,
+    replaced: bool,
+}
+impl AgentView {
+    fn update(&mut self, current: &tmuxx_terminal::AgentStatus, replaced: bool) {
+        self.current = current.clone();
+        self.replaced |= replaced;
+    }
+    fn take_event(&mut self) -> Option<SessionEvent> {
+        let empty = tmuxx_terminal::AgentStatus::default();
+        let previous = if self.replaced {
+            &empty
+        } else {
+            &self.delivered
+        };
+        let event = self.current.event_since(previous).or_else(|| {
+            (self.replaced && self.delivered.snapshot.is_some())
+                .then_some(rustty_vt::agent::Event::End)
+        });
+        self.delivered = self.current.clone();
+        self.replaced = false;
+        event.map(|event| SessionEvent::RestoredAgentStatus {
+            event,
+            enclosing_command: self.current.enclosing_command,
+        })
+    }
+}
+struct View {
+    agent: Arc<Mutex<AgentView>>,
+    terminal: Weak<Mutex<Terminal>>,
+    events: mpsc::SyncSender<SessionEvent>,
+    exited: Weak<AtomicBool>,
+    wake: Arc<dyn Fn() + Send + Sync>,
+    focused: Arc<AtomicBool>,
+    visible: Arc<AtomicBool>,
+    dark: Arc<AtomicBool>,
+    pending: Arc<Mutex<Vec<(u64, Effect)>>>,
+}
+struct Shared {
+    model: Mutex<Model>,
+    requests: mpsc::SyncSender<Request>,
+    next: AtomicU64,
+    wake: Arc<dyn Fn() + Send + Sync>,
+    closed: AtomicBool,
+    subscribe: bool,
+}
+
+/// One connection owns its workers and (only for `embedded`) its daemon lifetime.
+#[derive(Clone)]
+enum Source {
+    None,
+    #[cfg(unix)]
+    Unix(PathBuf),
+    #[cfg(windows)]
+    Windows(PathBuf),
+    Ssh {
+        host: String,
+        instance: Option<String>,
+        config: Option<PathBuf>,
+        remote_command: String,
+    },
+    SystemSsh {
+        host: String,
+        config: Option<PathBuf>,
+    },
+}
+type SizeViews = BTreeMap<u64, (Connection, (u16, u16, u16, u16))>;
+#[cfg(not(windows))]
+type NativeSshChild = Child;
+#[cfg(windows)]
+type NativeSshChild = tmuxx_runtime::OwnedStdioChild;
+
+pub struct Connection {
+    system: Option<system::SystemConnection>,
+    source: Source,
+    size_views: Mutex<SizeViews>,
+    shared: Arc<Shared>,
+    owner: Option<tmuxx_runtime::ServerHandle>,
+    child: Option<NativeSshChild>,
+    #[cfg(unix)]
+    socket: Option<std::os::unix::net::UnixStream>,
+    #[cfg(windows)]
+    pipe: Option<tmuxx_runtime::windows::PipeStream>,
+}
+
+#[derive(Clone)]
+pub struct PaneInput {
+    agent: Arc<Mutex<AgentView>>,
+    shared: Weak<Shared>,
+    pane: u64,
+    focused: Arc<AtomicBool>,
+    visible: Arc<AtomicBool>,
+    dark: Arc<AtomicBool>,
+    pending: Arc<Mutex<Vec<(u64, Effect)>>>,
+    owners: Arc<AtomicUsize>,
+    released: Arc<AtomicBool>,
+    native: bool,
