+            true,
+            true,
+        )
+    }
+    pub fn ssh(host: &str, wake: Arc<dyn Fn() + Send + Sync>) -> io::Result<Self> {
+        Self::native_ssh_command(host, None, crate::config::DEFAULT_TMUXX_SSH_COMMAND, wake)
