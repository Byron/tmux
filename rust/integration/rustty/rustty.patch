+        let remote = Connection::local(owner.native_endpoint().unwrap(), Arc::new(|| {})).unwrap();
+        let graph = wait(&remote, |graph| graph.panes.iter().any(|p| p.id == pane));
+        assert_eq!(graph.panes[0].pid, Some(pid));
+        let second = Session::attach_tmuxx(&remote, pane, Arc::new(|| {})).unwrap();
+        assert!(
+            matches!(&agent_events(&second)[..], [(Event::Begin(report), false)] if report.thread_id.as_deref() == Some("remote"))
+        );
+        second.write(b"x").unwrap();
+        wait(&remote, |graph| {
+            graph
+                .panes
+                .iter()
+                .any(|p| p.id == pane && p.status.is_some())
+        });
+        let deadline = Instant::now() + Duration::from_secs(5);
+        loop {
+            let events = second.events().collect::<Vec<_>>();
+            if events.iter().any(|event| {
+                matches!(
+                    event,
+                    SessionEvent::RestoredAgentStatus {
+                        event: Event::End,
+                        ..
+                    }
+                )
+            }) {
+                break;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "process exit retained the agent report"
+            );
+            thread::sleep(Duration::from_millis(5));
+        }
+        assert!(second.has_exited());
+    }
