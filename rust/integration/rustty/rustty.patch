+        if self.owners.fetch_sub(1, Ordering::AcqRel) == 1
+            && self.native
+            && let Some(shared) = self.shared.upgrade()
+        {
+            if shared
+                .model
+                .lock()
+                .is_ok_and(|model| !model.panes.contains_key(&self.pane))
+            {
+                return;
+            }
+            let _ = send(
+                &shared,
+                vec![
+                    b"tmuxx-release-pane".to_vec(),
+                    b"-t".to_vec(),
+                    format!("%{}", self.pane).into_bytes(),
