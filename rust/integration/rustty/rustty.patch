+    #[test]
+    fn retained_agent_snapshot_seeds_views_once_without_replaying_host_effects() {
+        use rustty_vt::agent::{Event, State};
+        let (connection, _requests) = Connection::base(Arc::new(|| {}), true);
+        let mut owner = tmuxx_terminal::Terminal::new(80, 24, 2000);
+        owner.feed(b"\x1b]133;C\x07");
+        owner.feed(&agent_frame(
+            br#"{"op":"begin","state":"working","thread_id":"remote"}"#,
+        ));
+        owner.feed(b"\x07\x1b]52;c;aGVsbG8=\x07\x1b[6n");
+        apply(&connection.shared, agent_snapshot(&mut owner, 1, 123, None)).unwrap();
+        let wakes = Arc::new(AtomicUsize::new(0));
+        let wake = {
+            let wakes = wakes.clone();
+            Arc::new(move || {
+                wakes.fetch_add(1, Ordering::SeqCst);
+            })
+        };
+        let first = Session::attach_tmuxx(&connection, 7, wake.clone()).unwrap();
+        let second = Session::attach_tmuxx(&connection, 7, wake).unwrap();
+        assert_eq!(
+            wakes.load(Ordering::SeqCst),
+            2,
+            "quiet retained views must wake without more output"
+        );
+        for session in [&first, &second] {
+            let events = agent_events(session);
+            assert_eq!(events.len(), 1);
+            assert!(
+                matches!(&events[0], (Event::Begin(report), true) if report.state == State::Working)
+            );
+        }
+        apply(&connection.shared, agent_snapshot(&mut owner, 2, 123, None)).unwrap();
+        assert!(agent_events(&first).is_empty());
+        assert!(agent_events(&second).is_empty());
+        owner.feed(&agent_frame(
+            br#"{"op":"update","state":"done","thread_id":"remote","turn_id":"one"}"#,
+        ));
+        apply(&connection.shared, agent_snapshot(&mut owner, 3, 123, None)).unwrap();
+        for session in [&first, &second] {
+            assert!(
+                matches!(&agent_events(session)[..], [(Event::Update(report), true)] if report.state == State::Done)
+            );
+        }
+        // The shell ended while detached. Restore End without replaying its
+        // command notification or repeating bell/clipboard/query effects.
+        owner.feed(b"\x1b]133;D;0\x07");
+        apply(&connection.shared, agent_snapshot(&mut owner, 4, 123, None)).unwrap();
+        assert_eq!(agent_events(&first), [(Event::End, false)]);
+        assert_eq!(agent_events(&second), [(Event::End, false)]);
+    }
