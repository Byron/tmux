+            .shared
+            .upgrade()
+            .ok_or_else(|| io::Error::from(io::ErrorKind::BrokenPipe))?;
+        send(
+            &shared,
+            vec![
+                b"tmuxx-retain-pane".to_vec(),
+                b"-t".to_vec(),
+                format!("%{}", self.pane).into_bytes(),
