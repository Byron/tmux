+                "profile":format!("{:?}",observed.guidProfile),
+                "service":format!("{:?}",observed.clsid), "scope":"calling GUI thread",
+            }))
+        })();
+        CoUninitialize();
+        result.map_err(|e| e.to_string())
+    }
+}
