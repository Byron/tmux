diff --git a/crates/rustty-app/tests/tmuxx_driver.rs b/crates/rustty-app/tests/tmuxx_driver.rs
new file mode 100644
index 000000000..e37cc0cd4
--- /dev/null
+++ b/crates/rustty-app/tests/tmuxx_driver.rs
@@ -0,0 +1,234 @@
+#![cfg(windows)]
+//! Execute the GUI binary's early CLI dispatch. Every helper belongs to a Job
+//! from CreateProcessW onward, including failure, timeout, and harness death.
+use rustty::{session::Session, tmuxx::Connection};
+use std::{
+    ffi::OsString,
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::Arc,
+    thread,
+    time::{Duration, Instant},
+};
+use tmuxx_runtime::OwnedStdioChild;
+
+struct ObservedProcess(windows::Win32::Foundation::HANDLE);
+impl ObservedProcess {
+    fn open(pid: u32) -> Self {
+        use windows::Win32::System::Threading::{OpenProcess, PROCESS_SYNCHRONIZE};
+        Self(unsafe { OpenProcess(PROCESS_SYNCHRONIZE, false, pid) }.unwrap())
+    }
+    fn assert_exited(&self) {
+        use windows::Win32::{Foundation::WAIT_OBJECT_0, System::Threading::WaitForSingleObject};
+        assert_eq!(
+            unsafe { WaitForSingleObject(self.0, 5000) },
+            WAIT_OBJECT_0,
+            "test-owned pane process survived driver shutdown"
+        );
+    }
+}
+impl Drop for ObservedProcess {
+    fn drop(&mut self) {
+        let _ = unsafe { windows::Win32::Foundation::CloseHandle(self.0) };
+    }
+}
+
+fn spawn(args: &[OsString]) -> OwnedStdioChild {
+    tmuxx_runtime::spawn_owned_stdio_piped_stderr(Path::new(env!("CARGO_BIN_EXE_rustty")), args)
+        .unwrap()
+}
+fn instance() -> String {
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    format!(
+        "rustty-driver-{}-{} 空间 &^%",
+        std::process::id(),
+        NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+    )
+}
+fn run(args: &[&str], input: &[u8]) -> std::process::Output {
+    let mut child = spawn(
+        &args
+            .iter()
+            .map(|arg| OsString::from(*arg))
+            .collect::<Vec<_>>(),
+    );
+    let mut stdout = child.stdout.take().unwrap();
+    let mut stderr = child.stderr.take().unwrap();
+    let output = thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stdout.read_to_end(&mut bytes).unwrap();
+        bytes
+    });
+    let errors = thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stderr.read_to_end(&mut bytes).unwrap();
+        bytes
+    });
+    child.stdin.take().unwrap().write_all(input).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let status = loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            child.kill().unwrap();
+            child.wait().unwrap();
+            panic!("Rustty tmux driver exceeded its bounded wait");
+        }
+        thread::sleep(Duration::from_millis(10));
+    };
+    std::process::Output {
+        status,
+        stdout: output.join().unwrap(),
+        stderr: errors.join().unwrap(),
+    }
+}
+fn wait_graph(
+    connection: &Connection,
+    predicate: impl Fn(&rustty::tmuxx::Graph) -> bool,
+) -> rustty::tmuxx::Graph {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        let errors = connection.errors();
+        assert!(errors.is_empty(), "{errors:?}");
+        if let Some(graph) = connection.graph()
+            && predicate(&graph)
+        {
+            return graph;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "Rustty driver graph did not converge"
+        );
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+fn connect_owner(endpoint: &Path, owner: &mut OwnedStdioChild) -> Connection {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        if let Ok(connection) = Connection::local(endpoint, Arc::new(|| {})) {
+            return connection;
+        }
+        assert!(
+            owner.try_wait().unwrap().is_none(),
+            "Rustty driver owner exited during startup"
+        );
+        assert!(
+            Instant::now() < deadline,
+            "Rustty driver did not create its endpoint"
+        );
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn windows_gui_tmux_dispatch_reports_version_and_missing_bridge_never_starts_owner() {
+    let version = run(&["tmux", "-V"], &[]);
+    assert!(version.status.success(), "{version:?}");
+    assert!(version.stdout.starts_with(b"tmuxx "), "{version:?}");
+    let name = instance();
+    let endpoint = rustty::tmuxx::windows_endpoint(&name).unwrap();
+    let missing = run(&["tmux", "--instance", &name, "list-sessions"], &[]);
+    assert!(!missing.status.success());
+    assert!(
+        missing.stdout.is_empty(),
+        "diagnostics leaked onto stdout: {missing:?}"
+    );
+    assert!(!missing.stderr.is_empty());
+    let mut hello = serde_json::to_vec(&serde_json::json!({"version":1,"instance":name})).unwrap();
+    hello.push(b'\n');
+    let bridge = run(&["tmux", "--native-stdio"], &hello);
+    assert!(!bridge.status.success());
+    assert!(
+        bridge.stdout.is_empty(),
+        "diagnostics leaked onto bridge stdout: {bridge:?}"
+    );
+    assert!(!bridge.stderr.is_empty());
+    assert!(Connection::local(&endpoint, Arc::new(|| {})).is_err());
+}
+
+#[test]
+fn windows_gui_tmux_driver_owns_one_retained_process_across_local_and_stdio_views() {
+    // This must run with the same pinned package as the standalone/GUI tests.
+    let resources = PathBuf::from(
+        std::env::var_os("TMUXX_CONPTY_RESOURCES")
+            .expect("TMUXX_CONPTY_RESOURCES must identify the hash-verified packaged runtime"),
+    );
+    assert!(resources.join("conpty/conpty.dll").is_file());
+    // PATH can resolve a Python launcher which owns a second interpreter PID.
+    // Use the conformance runner's native interpreter for an exact pane PID oracle.
+    let python = std::env::var("TMUXX_REMOTE_PYTHON")
+        .expect("TMUXX_REMOTE_PYTHON must identify the absolute native Python interpreter");
+    assert!(Path::new(&python).is_absolute());
+    let endpoint = rustty::tmuxx::windows_endpoint(&instance()).unwrap();
+    let mut owner = spawn(&[
+        "tmux".into(),
+        "-D".into(),
+        "--native-endpoint".into(),
+        endpoint.as_os_str().to_owned(),
+    ]);
+    let local = connect_owner(&endpoint, &mut owner);
+    wait_graph(&local, |_| true);
+    let name = "driver 空间 &^%";
+    local.command(["new-session", "-d", "-s", name, &python, "-u", "-c",
+        "import os,time; os.write(1,('DRIVER:'+str(os.getpid())+'\\r\\n').encode()); time.sleep(180)"]).unwrap();
+    let graph = wait_graph(&local, |graph| !graph.panes.is_empty());
+    assert_eq!(graph.sessions[0].name, name);
+    let pane = graph.panes[0].id;
+    let pid = graph.panes[0].pid.expect("native driver PID");
+    let pane_process = ObservedProcess::open(pid);
+    let view = Session::attach_tmuxx(&local, pane, Arc::new(|| {})).unwrap();
+    view.set_persistent(true).unwrap();
+    wait_graph(&local, |graph| graph.panes[0].persistent);
+    let mut bridge = spawn(&[
+        "tmux".into(),
+        "--native-stdio".into(),
+        "--native-endpoint".into(),
+        endpoint.as_os_str().to_owned(),
+    ]);
+    let remote = Connection::stream(
+        bridge.stdout.take().unwrap(),
+        bridge.stdin.take().unwrap(),
+        Arc::new(|| {}),
+    )
+    .unwrap();
+    let graph = wait_graph(&remote, |graph| !graph.panes.is_empty());
+    assert_eq!(graph.panes[0].pid, Some(pid));
+    assert_eq!(graph.sessions[0].name, name);
+    bridge.kill().unwrap();
+    bridge.wait().unwrap();
+    drop(remote);
+    assert!(
+        owner.try_wait().unwrap().is_none(),
+        "bridge termination killed the owner"
+    );
+    drop(view);
+    drop(local);
+    let reconnected = Connection::local(&endpoint, Arc::new(|| {})).unwrap();
+    let graph = wait_graph(&reconnected, |graph| !graph.panes.is_empty());
+    assert_eq!(graph.panes[0].pid, Some(pid));
+    let view = Session::attach_tmuxx(&reconnected, pane, Arc::new(|| {})).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        let text = view.terminal().unwrap().plain_text();
+        if text.contains(&format!("DRIVER:{pid}")) {
+            break;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "retained driver output missing: {text}"
+        );
+        thread::sleep(Duration::from_millis(10));
+    }
+    reconnected.command(["kill-server"]).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while owner.try_wait().unwrap().is_none() {
+        assert!(
+            Instant::now() < deadline,
+            "driver owner did not stop gracefully"
+        );
+        thread::sleep(Duration::from_millis(10));
+    }
+    owner.wait().unwrap();
+    pane_process.assert_exited();
+}
